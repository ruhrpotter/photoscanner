msgstr "Die Zieldatei existiert bereits: {path}"

msgid "The scanner process could not be started: {error}"
msgstr "Der Scannerprozess konnte nicht gestartet werden: {error}"

msgid "Pipe reader thread aborted"
msgstr "Thread zum Lesen der Pipe wurde abgebrochen"

msgid "unknown SANE error"
msgstr "unbekannter SANE-Fehler"

msgid "unknown error"
msgstr "unbekannter Fehler"

msgid "The input file does not exist: {path}"
msgstr "Die Eingabedatei existiert nicht: {path}"

msgid "The image could not be processed: {error}"
msgstr "Das Bild konnte nicht verarbeitet werden: {error}"

msgid "File operation failed: {error}"
msgstr "Dateioperation fehlgeschlagen: {error}"

msgid "Image metadata could not be processed: {detail}"
msgstr "Bildmetadaten konnten nicht verarbeitet werden: {detail}"

msgid "No individual photos were detected. Leave space between the photos or try a lower threshold."
msgstr "Es wurden keine einzelnen Fotos erkannt. Lasse Abstand zwischen den Fotos oder versuche einen niedrigeren Schwellwert."

msgid "The selected capture date is invalid in the local time zone."
msgstr "Das ausgewählte Aufnahmedatum ist in der lokalen Zeitzone ungültig."

msgid "Supported formats are JPG, PNG and TIFF."
msgstr "Unterstützte Formate sind JPG, PNG und TIFF."

msgid "Minimum area must be between 0.1 and 50 percent."
msgstr "Die Mindestfläche muss zwischen 0,1 und 50 Prozent liegen."

msgid "Threshold must be between 1 and 255."
msgstr "Der Schwellwert muss zwischen 1 und 255 liegen."

msgid "Padding must be between 0 and 15 percent."
msgstr "Der Rand muss zwischen 0 und 15 Prozent liegen."

msgid "Maximum detection size must be between {minimum} and {maximum} pixels."
msgstr "Die maximale Erkennungsgröße muss zwischen {minimum} und {maximum} Pixeln liegen."

msgid "JPEG quality must be between 1 and 100."
msgstr "Die JPEG-Qualität muss zwischen 1 und 100 liegen."

msgid "The file prefix must be exactly one safe file name with at most {maximum} bytes."
msgstr "Das Dateipräfix muss genau ein sicherer Dateiname mit höchstens {maximum} Bytes sein."

msgid "The image dimensions are invalid."
msgstr "Die Bildabmessungen sind ungültig."

msgid "The scanned image is too small or has an invalid format."
msgstr "Das gescannte Bild ist zu klein oder hat ein ungültiges Format."

msgid "The image is too large at {width}×{height} pixels. At most {maximum_pixels} pixels and {maximum_edge} pixels per edge are allowed."
msgstr "Das Bild ist mit {width}×{height} Pixeln zu groß. Erlaubt sind höchstens {maximum_pixels} Pixel und {maximum_edge} Pixel pro Kante."

msgid "The image header could not be read: {error}"
msgstr "Der Bildheader konnte nicht gelesen werden: {error}"

msgid "Image dimensions could not be verified safely before loading. PNG, JPEG and TIFF are supported."
msgstr "Die Bildabmessungen konnten vor dem Laden nicht sicher geprüft werden. PNG, JPEG und TIFF werden unterstützt."

msgid "The scanned image has an invalid format or inconsistent dimensions."
msgstr "Das gescannte Bild hat ein ungültiges Format oder widersprüchliche Abmessungen."

msgid "Publishing failed ({publish_error}); rollback also failed ({rollback_error})"
msgstr "Veröffentlichen fehlgeschlagen ({publish_error}); auch das Zurückrollen ist fehlgeschlagen ({rollback_error})"

msgid "No available file name could be determined."
msgstr "Es konnte kein freier Dateiname ermittelt werden."

msgid "The image could not be saved: {path}"
msgstr "Das Bild konnte nicht gespeichert werden: {path}"

msgid "Exactly one preview region must be supplied for each exported photo."
msgstr "Für jedes exportierte Foto muss genau ein Vorschaubereich angegeben werden."

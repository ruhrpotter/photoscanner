msgid "The 'exiv2' image metadata program was not found. Install it with your package manager (e.g. 'sudo pacman -S exiv2' on Arch)."
msgstr "Das Bildmetadaten-Programm 'exiv2' wurde nicht gefunden. Unter CachyOS/Arch kann es mit 'sudo pacman -S exiv2' installiert werden."

msgid "The metadata process could not be executed: {error}"
msgstr "Der Metadatenprozess konnte nicht ausgeführt werden: {error}"

msgid "Metadata from '{path}' could not be read: {detail}"
msgstr "Metadaten aus '{path}' konnten nicht gelesen werden: {detail}"

msgid "Metadata for '{path}' could not be written: {detail}"
msgstr "Metadaten für '{path}' konnten nicht geschrieben werden: {detail}"

msgid "The metadata file path could not be resolved: {error}"
msgstr "Der Dateipfad für die Metadaten konnte nicht aufgelöst werden: {error}"

msgid "The modification date could not be set: {error}"
msgstr "Das Änderungsdatum konnte nicht gesetzt werden: {error}"

msgid "exiv2 exited with status {status}"
msgstr "exiv2 wurde mit Status {status} beendet"

msgid "SANE is not installed: The 'scanimage' program was not found. Install it with your package manager (e.g. 'sudo pacman -S sane sane-airscan' on Arch)."
msgstr "SANE ist nicht installiert: Das Programm 'scanimage' wurde nicht gefunden. Unter CachyOS/Arch kann es mit 'sudo pacman -S sane sane-airscan' installiert werden."

msgid "Scanner discovery timed out."
msgstr "Die Gerätesuche hat ihr Zeitlimit überschritten."

msgid "Scanners could not be queried: {detail}"
msgstr "Scanner konnten nicht abgefragt werden: {detail}"

msgid "Resolution must be between 75 and 2400 dpi."
msgstr "Die Auflösung muss zwischen 75 und 2400 dpi liegen."

msgid "The scan timed out."
msgstr "Der Scan hat sein Zeitlimit überschritten."

msgid "The operation was cancelled."
msgstr "Der Vorgang wurde abgebrochen."

msgid "The scan failed: {detail}"
msgstr "Der Scan ist fehlgeschlagen: {detail}"

